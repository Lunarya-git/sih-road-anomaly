# ---- ML data (too large for git, not LFS-tracked) ----
ml/data/*
!ml/data/.gitkeep

# ---- ML weights are tracked via Git LFS (*.pt etc.) ----
# Large model files are handled by LFS — see .gitattributes

# ---- Python ----
__pycache__/
*.pyc
.venv/
venv/
env/
*.egg-info/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- OS / editor ----
.DS_Store
.vscode/
.idea/
*.log

# ---- Backend / app (teammates can extend this) ----
backend/node_modules/
backend/.env
app/node_modules/
app/build/
